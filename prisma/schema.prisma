// MyXploit - Database Schema
// Gestion des marchés CVC et performance énergétique

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ORGANIZATION & USERS (Multi-tenant)
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  stampUrl  String? // Tampon entreprise (image R2), apposé sur les devis acceptés
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                   User[]
  sites                   Site[]
  siteAliases             SiteAlias[]
  importTemplates         ImportTemplate[]
  contracts               Contract[]
  invoices                Invoice[]
  quotes                  Quote[]
  renewalItems            ContractRenewalItem[]
  meetings                Meeting[]
  alerts                  Alert[]
  equipments              Equipment[]
  consumptions            Consumption[]
  energyProviders         EnergyProvider[]
  // Configuration audit technique (ancien système)
  checklistTemplates      ChecklistTemplate[]
  recommendationTemplates RecommendationTemplate[]
  checklistCategories     ChecklistCategory[]
  // Nouveau système d'audit configurable
  recommendationLibrary   RecommendationLibrary[]
  auditCheckPoints        AuditCheckPoint[]
  tickets                 Ticket[]
  regulatoryControlTypes  RegulatoryControlType[]
  regulatoryControls      RegulatoryControl[]
  // Permissions et modules
  modules                 OrganizationModule[]
  ghostSessions           GhostSession[]
  userContractAssignments UserContractAssignment[]
  siteActivityLogs        SiteActivityLog[]
  clients                 Client[]
  missionTypes            MissionType[]
  missions                Mission[]
  onboardingCompleted     Boolean                  @default(false)

  @@map("organizations")
}

// ============================================
// CLIENT (Collectivité / entité servie par le cabinet AMO)
// ============================================

model Client {
  id             String   @id @default(cuid())
  name           String // "Ville de Lyon", "Région Auvergne"
  siret          String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  city           String?
  postalCode     String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites        Site[]
  contracts    Contract[]
  missions     Mission[]

  @@map("clients")
}

// ============================================
// MISSIONS AMO
// ============================================

enum MissionStatus {
  PROSPECT // En cours de négociation (pipeline)
  ACTIVE // Mission en cours
  EN_PAUSE // Mission suspendue
  TERMINEE // Mission terminée
  ANNULEE // Mission annulée
}

enum BillingModality {
  FORFAIT // Montant fixe
  REGIE // Temps passé
  POURCENTAGE // % du montant travaux
  MIXTE // Combinaison
}

enum DeliverableStatus {
  A_FAIRE // À faire
  EN_COURS // En cours de production
  PRODUIT // Produit (terminé par l'ingénieur)
  TRANSMIS // Transmis au client
}

// Type de mission configurable par organisation
model MissionType {
  id             String   @id @default(cuid())
  name           String // "Suivi de contrat", "Audit énergétique", etc.
  organizationId String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  missions     Mission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("mission_types")
}

model Mission {
  id              String           @id @default(cuid())
  reference       String // Auto-généré: MIS-2026-0001
  title           String
  description     String?
  status          MissionStatus    @default(ACTIVE)
  missionTypeId   String
  clientId        String
  organizationId  String
  startDate       DateTime?
  endDate         DateTime?
  amountHT        Float?
  billingModality BillingModality?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  missionType  MissionType             @relation(fields: [missionTypeId], references: [id])
  client       Client                  @relation(fields: [clientId], references: [id])
  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
  engineers    UserMissionAssignment[]
  sites        MissionSite[]
  contracts    MissionContract[]

  @@index([organizationId])
  @@index([clientId])
  @@index([missionTypeId])
  @@index([status])
  @@map("missions")
}

model Deliverable {
  id              String            @id @default(cuid())
  title           String // "Rapport annuel", "Note d'audit", "CCTP"
  description     String?
  status          DeliverableStatus @default(A_FAIRE)
  dueDate         DateTime?
  completedDate   DateTime? // Date de production
  transmittedDate DateTime? // Date de transmission au client
  fileUrl         String? // Lien vers le document
  missionId       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@index([status])
  @@index([dueDate])
  @@map("deliverables")
}

// Assignation ingénieur à une mission
model UserMissionAssignment {
  id         String   @id @default(cuid())
  userId     String
  missionId  String
  assignedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("user_mission_assignments")
}

// Sites rattachés à une mission
model MissionSite {
  id        String @id @default(cuid())
  missionId String
  siteId    String

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([missionId, siteId])
  @@map("mission_sites")
}

// Contrats d'exploitation rattachés à une mission
model MissionContract {
  id         String @id @default(cuid())
  missionId  String
  contractId String

  mission  Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([missionId, contractId])
  @@map("mission_contracts")
}

enum UserRole {
  SUPER_ADMIN // Plateforme - accès toutes orgs en mode fantôme
  ADMIN // Org - gère les utilisateurs de son org
  EDITOR // Org - crée/modifie/supprime dans son org
  MANAGER // @deprecated - migrer vers EDITOR
  READER // Org - consulte et exporte uniquement
}

// Modules fonctionnels (accès configurable par organisation)
enum Module {
  ENERGY // Suivi énergétique
  FINANCIER // Suivi financier
  ADMINISTRATIF // Suivi administratif
  EXPLOITATION // Suivi exploitation
  OUTILS // Boîte à outils
  CONTRACTS // Gestion contrats
  PRICING // Tarification
}

// Profil métier de l'utilisateur (expérience personnalisée)
enum UserProfile {
  EXPLOITANT // Entreprise de maintenance (Engie, Dalkia, etc.) - Focus: interventions, équipements, rapports
  CLIENT // Propriétaire/gestionnaire du patrimoine - Focus: coûts, conformité contrat, performance
  AMO // Assistant Maîtrise d'Ouvrage - Focus: audits, pilotage global, reporting
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  password          String? // Hashed password (null = invitation en attente)
  firstName         String?
  lastName          String?
  role              UserRole     @default(READER)
  profile           UserProfile? // Profil métier (null = pas encore choisi)
  organizationId    String
  invitationToken   String?      @unique // Token pour accepter l'invitation
  invitationExpires DateTime? // Expiration du token
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdSites        Site[]                   @relation("CreatedBy")
  ghostSessions       GhostSession[]           @relation("SuperAdminGhostSessions")
  quotesAccepted      Quote[]                  @relation("QuoteAcceptedBy")
  quotesRefused       Quote[]                  @relation("QuoteRefusedBy")
  invoicesAccepted    Invoice[]                @relation("InvoiceAcceptedBy")
  invoicesRefused     Invoice[]                @relation("InvoiceRefusedBy")
  ticketsCreated      Ticket[]                 @relation("TicketCreatedBy")
  contractAssignments UserContractAssignment[]
  missionAssignments  UserMissionAssignment[]
  siteActivityLogs    SiteActivityLog[]

  @@map("users")
}

// Modules activés par organisation
model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String
  module         Module
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module])
  @@index([organizationId])
  @@map("organization_modules")
}

// Sessions fantômes pour SUPER_ADMIN
model GhostSession {
  id                   String   @id @default(cuid())
  superAdminId         String
  targetOrganizationId String
  createdAt            DateTime @default(now())
  expiresAt            DateTime // Auto-expire après 4h

  superAdmin         User         @relation("SuperAdminGhostSessions", fields: [superAdminId], references: [id], onDelete: Cascade)
  targetOrganization Organization @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
  @@index([targetOrganizationId])
  @@map("ghost_sessions")
}

// ============================================
// ASSIGNATION CONTRATS (Portefeuilles ingénieurs)
// ============================================

// Assignation d'un utilisateur comme référent d'un contrat
model UserContractAssignment {
  id             String   @id @default(cuid())
  userId         String
  contractId     String
  organizationId String
  assignedAt     DateTime @default(now())
  assignedById   String? // Qui a fait l'assignation

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, contractId])
  @@index([userId])
  @@index([contractId])
  @@index([organizationId])
  @@map("user_contract_assignments")
}

// ============================================
// JOURNAL D'ACTIVITÉ SITES
// ============================================

enum SiteActivityType {
  PANNE_CHAUFFAGE // Panne chauffage
  PANNE_ECS // Panne ECS
  PANNE_VENTILATION // Panne ventilation / climatisation
  FUITE // Fuite eau / gaz
  DYSFONCTIONNEMENT // Dysfonctionnement équipement
  COUPURE // Coupure énergie / alimentation
  PLAINTE_USAGER // Plainte / signalement usager
  INTERVENTION // Intervention exploitant
  INCIDENT // Incident divers
  ASSIGNATION // Changement d'assignation (auto)
  NOTE // Note libre
}

model SiteActivityLog {
  id             String           @id @default(cuid())
  siteId         String
  userId         String
  organizationId String
  activityType   SiteActivityType
  title          String
  description    String?
  activityDate   DateTime         @default(now())
  createdAt      DateTime         @default(now())

  // Relations
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([userId])
  @@index([activityDate])
  @@map("site_activity_logs")
}

// ============================================
// SITES / PATRIMOINE
// ============================================

enum SiteType {
  LYCEE
  COLLEGE
  ECOLE
  MAIRIE
  HOPITAL
  GYMNASE
  PISCINE
  MEDIATHEQUE
  AUTRE
}

// Niveau d'isolation du bâtiment
enum InsulationLevel {
  AUCUNE // Avant 1974, pas d'isolation
  PARTIELLE // Isolation partielle (combles ou murs)
  RT1974 // Conforme RT 1974
  RT1988 // Conforme RT 1988
  RT2000 // Conforme RT 2000
  RT2005 // Conforme RT 2005
  RT2012 // Conforme RT 2012
  RE2020 // Conforme RE 2020
}

// Type de vitrage
enum GlazingType {
  SIMPLE // Simple vitrage
  DOUBLE // Double vitrage standard
  DOUBLE_FE // Double vitrage faible émissivité
  TRIPLE // Triple vitrage
}

// Type de ventilation
enum VentilationType {
  NATURELLE // Ventilation naturelle
  SIMPLE_FLUX // VMC simple flux
  HYGRO_B // VMC hygroréglable B
  DOUBLE_FLUX // VMC double flux avec récupération
}

enum EnergyType {
  GAZ
  ELECTRICITE
  FIOUL
  BOIS
  RESEAU_CHALEUR
  EAU // Appoint d'eau
  AUTRE
}

// Usage de l'énergie (pour séparer chauffage et ECS)
enum EnergyUsage {
  CHAUFFAGE // Chauffage seul (soumis aux DJU)
  ECS // Eau Chaude Sanitaire (non soumis aux DJU)
  MIXTE // Chauffage + ECS combiné
  AUTRE // Autre usage
}

enum NbUnit {
  PCS // Pouvoir Calorifique Supérieur
  UTILE // Énergie utile
}

model Site {
  id               String           @id @default(cuid())
  name             String
  type             SiteType
  address          String
  city             String
  postalCode       String
  surface          Float? // m² (surface totale)
  surfaceChauffee  Float? // m² (surface chauffée)
  energyType       EnergyType
  // Données énergétiques P1
  nb               Float? // Niveau de Base / Cible énergétique (MWh)
  nbUnit           NbUnit? // Unité du NB (PCS ou Utile)
  djuContractuel   Float? // DJU Contractuels (trentenaire station météo)
  stationMeteo     String? // Station météo de référence (ex: "ORLY", "LYON-BRON")
  pce              String? // Point de Comptage et d'Estimation (compteur gaz)
  pdl              String? // Point de Livraison (compteur électricité)
  rae              String? // Référence Acheminement Électricité
  // Caractéristiques bâtiment (profil thermique)
  constructionYear Int? // Année de construction
  numberOfFloors   Int? // Nombre de niveaux
  buildingHeight   Float? // Hauteur moyenne sous plafond (m)
  volumeChauffee   Float? // Volume chauffé (m³) - calculé ou saisi
  insulationLevel  InsulationLevel? // Niveau d'isolation
  glazingType      GlazingType? // Type de vitrage
  ventilationType  VentilationType? // Type de ventilation

  // Autres infos
  annualBudget   Float? // Budget annuel estimé
  latitude       Float?
  longitude      Float?
  image          String?
  organizationId String
  clientId       String? // Client (collectivité) rattaché
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("CreatedBy", fields: [createdById], references: [id])
  contractSites      ContractSite[] // Relation vers les contrats via la table pivot
  equipments         Equipment[]
  consumptions       Consumption[]
  meters             Meter[] // Compteurs du site (schéma de comptage)
  invoices           Invoice[]
  alerts             Alert[]
  meetings           Meeting[]
  quotes             Quote[]
  renewalItems       ContractRenewalItem[]
  poolBasins         PoolBasin[] // Bassins de piscine pour ce site
  heatingSeasons     HeatingSeason[] // Saisons de chauffage (contiennent le NB)
  heatingPeriods     HeatingPeriod[] // Périodes de chauffe (dates allumage/arrêt)
  aliases            SiteAlias[] // Alias pour l'import de données
  technicalAudits    TechnicalAudit[] // Audits techniques du site
  occupationZones    OccupationZone[] // Zones d'occupation thermique
  tickets            Ticket[] // Points de suivi
  regulatoryControls RegulatoryControl[] // Contrôles réglementaires
  activityLogs       SiteActivityLog[] // Journal d'activité
  missionSites       MissionSite[] // Missions rattachées

  @@index([organizationId])
  @@index([clientId])
  @@map("sites")
}

// Zone d'occupation thermique d'un bâtiment
// Permet de définir les horaires et températures de consigne par zone
model OccupationZone {
  id           String @id @default(cuid())
  siteId       String
  name         String // Ex: "Salles de classe", "Gymnase", "Bureaux"
  surface      Float? // Surface de la zone (m²)
  tempConsigne Float  @default(19) // Température de consigne occupation (°C)
  tempReduit   Float  @default(16) // Température réduit hors occupation (°C)

  // Planning hebdomadaire (JSON: { lundi: [{start: "08:00", end: "18:00"}], ... })
  weeklySchedule Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("occupation_zones")
}

// Alias de site pour l'import de données
// Permet de mapper les noms de sites des fichiers Excel aux sites existants
model SiteAlias {
  id             String   @id @default(cuid())
  alias          String // Le nom dans le fichier Excel (ex: "COMPLEXTE SPORTIF CHRISTINE CARON")
  source         String? // Source du fichier (ex: "IDEX", "ENGIE", "DALKIA")
  siteId         String // Le site correspondant
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([alias, source, organizationId]) // Un alias unique par source et organisation
  @@index([organizationId])
  @@index([alias])
  @@map("site_aliases")
}

// Gabarit d'import exploitant : mémorise le mapping colonne → notion d'une trame,
// identifiée par la signature de ses en-têtes (triés + normalisés). Partagé par
// toute l'organisation — remplace la mémorisation localStorage du banc de test.
model ImportTemplate {
  id             String   @id @default(cuid())
  organizationId String
  signature      String // Signature des en-têtes du fichier (norm + tri + join "|")
  name           String? // Libellé lisible (ex: nom du 1er fichier mappé)
  mapping        Json // { notion: "libellé de colonne" } (ex: { site: "Installation" })
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, signature]) // Une trame = un gabarit par organisation
  @@map("import_templates")
}

// ============================================
// EQUIPEMENTS CVC
// ============================================

// Domaine de l'équipement CVC
enum EquipmentDomain {
  CHAUFFAGE
  ECS // Eau Chaude Sanitaire
  VENTILATION
  CLIMATISATION
  TRAITEMENT_EAU
  PLOMBERIE
  CFO_CFA // Courants Forts / Courants Faibles (électricité)
  COMPTAGE // Compteurs et instruments de mesure
  PISCINE // Traitement eau et chauffage piscines
  AUTRE
}

enum EquipmentType {
  // === CHAUFFAGE ===
  CHAUDIERE
  CHAUDIERE_CONDENSATION
  PAC // Pompe à chaleur
  PAC_AIR_EAU
  PAC_EAU_EAU
  PAC_AIR_AIR
  RADIATEUR
  PLANCHER_CHAUFFANT
  CONVECTEUR
  AEROTERME
  RADIANT_GAZ // Radiant gaz
  VANNE_3_VOIES
  VANNE_MOTORISEE
  POMPE_CHAUFFAGE
  CIRCULATEUR
  VASE_EXPANSION
  ECHANGEUR_THERMIQUE
  BRULEUR
  REGULATEUR
  AUTOMATE // Automate de régulation / GTB
  SONDE_TEMPERATURE
  SONDE_EXTERIEURE
  // === ECS ===
  BALLON_ECS
  BALLON_THERMODYNAMIQUE
  PREPARATEUR_ECS_GAZ // Préparateur ECS Gaz
  ECHANGEUR_ECS
  POMPE_BOUCLAGE
  MITIGEUR_THERMOSTATIQUE
  RESISTANCE_ELECTRIQUE
  // === VENTILATION ===
  VMC
  VMC_SIMPLE_FLUX
  VMC_DOUBLE_FLUX
  CTA // Centrale de traitement d'air
  CAISSON_EXTRACTION
  CAISSON_SOUFFLAGE
  VENTILATEUR
  REGISTRE
  BATTERIE_CHAUDE
  BATTERIE_FROIDE
  RECUPERATEUR_CHALEUR
  // === CLIMATISATION ===
  GROUPE_FROID
  CLIMATISATION // Gardé pour compatibilité
  CLIMATISEUR
  SPLIT
  MULTI_SPLIT
  CASSETTE
  GAINABLE
  ROOFTOP
  DRV // Débit de Régulation Variable
  // === TRAITEMENT EAU ===
  ADOUCISSEUR
  DISCONNECTEUR
  FILTRE
  POT_BOUE
  DEGAZEUR
  DOSEUR
  // === PLOMBERIE ===
  COMPTEUR_EAU
  VANNE_GENERALE
  SURPRESSEUR
  BACHE_EAU
  REDUCTION_PRESSION
  POMPE_RELEVAGE // Pompe de relevage
  STATION_RELEVAGE // Station de relevage
  // === CFO/CFA (Électricité) ===
  ARMOIRE_ELECTRIQUE
  ARMOIRE_TGBT // Tableau Général Basse Tension
  ARMOIRE_TD // Tableau Divisionnaire
  ONDULEUR
  GROUPE_ELECTROGENE
  TRANSFORMATEUR
  BAIE_INFORMATIQUE
  // === COMPTAGE ===
  COMPTEUR_ENERGIE // Compteur d'énergie thermique
  COMPTEUR_CALORIES // Compteur de calories
  COMPTEUR_FRIGORIES // Compteur de frigories
  COMPTEUR_ECS // Compteur ECS
  COMPTEUR_GAZ // Compteur gaz
  COMPTEUR_ELECTRIQUE // Compteur électrique
  SOUS_COMPTEUR_ELEC // Sous-compteur électrique
  COMPTEUR_HORAIRE // Compteur horaire
  COMPTEUR_APPOINT // Compteur d'appoint
  ANALYSEUR_RESEAU // Analyseur de réseau électrique
  SONDE_TEMPERATURE_AMB // Sonde de température ambiante
  SONDE_HYGROMETRIE // Sonde d'hygrométrie
  CAPTEUR_CO2 // Capteur CO2
  CAPTEUR_QUALITE_AIR // Capteur qualité d'air
  // === PISCINE ===
  FILTRE_PISCINE // Filtre à sable/diatomée/verre
  POMPE_FILTRATION // Pompe de filtration piscine
  PAC_PISCINE // Pompe à chaleur piscine
  ECHANGEUR_PISCINE // Échangeur thermique piscine
  CHAUDIERE_PISCINE // Chaudière dédiée piscine
  ELECTROLYSEUR_SEL // Électrolyseur au sel
  TRAITEMENT_CHLORE // Système de chloration
  TRAITEMENT_UV // Traitement UV
  TRAITEMENT_OZONE // Traitement ozone
  REGULATEUR_PH // Régulateur pH automatique
  REGULATEUR_CHLORE // Régulateur chlore/redox
  POMPE_DOSEUSE // Pompe doseuse produits
  SONDE_PH // Sonde pH
  SONDE_REDOX // Sonde redox/chlore
  SONDE_TEMPERATURE_EAU // Sonde température eau bassin
  DESHUMIDIFICATEUR // Déshumidificateur hall bassin
  CTA_PISCINE // Centrale traitement air piscine
  BACHE_TAMPON // Bâche tampon / bac tampon
  NAGE_CONTRE_COURANT // Système nage contre-courant
  ROBOT_NETTOYAGE // Robot de nettoyage automatique
  // === AUTRE ===
  AUTRE
}

enum EquipmentStatus {
  OPERATIONNEL
  MAINTENANCE
  PANNE
  HORS_SERVICE
}

// Note de 1 à 5 pour les critères d'audit
enum AuditRating {
  NON_EVALUE // 0 - Pas encore évalué
  CRITIQUE // 1 - À remplacer d'urgence
  MAUVAIS // 2 - Défaillances majeures
  MOYEN // 3 - Acceptable mais à surveiller
  BON // 4 - En bon état
  EXCELLENT // 5 - État neuf ou quasi-neuf
}

// Résultat global d'un audit technique
enum TechnicalAuditResult {
  NON_VERIFIE // Pas encore vérifié
  CONFORME // Tous les points conformes
  NON_CONFORME // Au moins un point non conforme critique
  PARTIEL // Certains points conformes, d'autres non
}

model Equipment {
  id                  String          @id @default(cuid())
  name                String? // Optionnel - auto-généré depuis le type si vide
  domain              EquipmentDomain @default(CHAUFFAGE)
  type                EquipmentType
  brand               String?
  model               String?
  serialNumber        String?
  imageUrl            String? // URL de l'image de l'équipement
  year                Int? // Année de fabrication
  installDate         DateTime?
  warrantyEnd         DateTime?
  power               Float? // kW
  quantity            Int? // Quantité (pour émetteurs: radiateurs, convecteurs, etc.)
  // Localisation dans le site
  location            String? // Local/Pièce (ex: "Chaufferie", "Sous-sol technique")
  level               String? // Niveau/Étage (ex: "RDC", "Sous-sol", "Toiture")
  serviceArea         String? // Zone desservie (ex: "Bâtiment A", "Aile Nord")
  // Liste contradictoire (équipement sur liste vs présent sur site)
  inContractList      Boolean         @default(true) // Figure sur la liste contractuelle
  presentOnSite       Boolean         @default(true) // Présent physiquement sur site
  // Durée de vie théorique
  theoreticalLifespan Int? // Durée de vie en années (ex: 20 pour chaudière)
  status              EquipmentStatus @default(OPERATIONNEL)
  siteId              String
  organizationId      String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relations
  site               Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  avenantItems         AvenantItem[] // Modifications d'avenant concernant cet équipement
  audits               EquipmentAudit[] // Historique des audits simples
  regulatoryControls   RegulatoryControl[] // Contrôles réglementaires liés
  renewalItems         ContractRenewalItem[] // Postes du plan de renouvellement P3
  auditRecommendations AuditRecommendation[] // Préconisations le concernant

  @@index([organizationId])
  @@index([siteId])
  @@map("equipments")
}

// Audit d'un équipement (relevé sur site)
model EquipmentAudit {
  id                 String      @id @default(cuid())
  equipmentId        String
  auditDate          DateTime // Date de l'audit
  auditor            String? // Nom de l'auditeur
  // Critères d'évaluation (notes)
  visualState        AuditRating @default(NON_EVALUE) // État visuel
  performance        AuditRating @default(NON_EVALUE) // Performance
  security           AuditRating @default(NON_EVALUE) // Sécurité
  accessibility      AuditRating @default(NON_EVALUE) // Accessibilité
  compliance         AuditRating @default(NON_EVALUE) // Conformité réglementaire
  // Commentaires et observations
  visualNotes        String? // Notes sur l'état visuel
  performanceNotes   String? // Notes sur la performance
  securityNotes      String? // Notes sur la sécurité
  accessibilityNotes String? // Notes sur l'accessibilité
  complianceNotes    String? // Notes sur la conformité
  generalNotes       String? // Observations générales
  // Photos
  photos             String[] // URLs des photos
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("equipment_audits")
}

// Audit technique d'un site (checklist de conformité par type d'équipement)
model TechnicalAudit {
  id             String               @id @default(cuid())
  siteId         String
  auditDate      DateTime // Date de l'audit
  auditor        String? // Nom de l'auditeur
  // Résultats de la checklist (stocké en JSON)
  // Format: [{equipmentType, itemId, label, category, result: "CONFORME"|"NON_CONFORME"|"NA"|"NON_VERIFIE", notes?}]
  checklistItems Json
  globalResult   TechnicalAuditResult @default(NON_VERIFIE)
  generalNotes   String? // Observations générales
  photos         String[] // URLs des photos
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Relations
  site            Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  recommendations AuditRecommendation[] // Préconisations générées
  workLevees      WorkLevee[] // Levées de réserves liées à cet audit

  @@map("technical_audits")
}

// ============================================
// CONFIGURATION AUDIT TECHNIQUE (Admin)
// ============================================

// Template de checklist configurable par l'admin
model ChecklistTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String // Ex: "Chaudière", "Disconnecteur"
  domain         String // Ex: "CHAUFFAGE", "PLOMBERIE"
  equipmentTypes String[] // Types d'équipements concernés
  description    String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ChecklistTemplateItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("checklist_templates")
}

// Item de checklist avec textes de rapport
model ChecklistTemplateItem {
  id                  String   @id @default(cuid())
  templateId          String
  itemKey             String // Clé unique dans le template (ex: "schema_principe")
  label               String // Label affiché (ex: "Schéma de principe présent")
  category            String // Catégorie (ex: "DOSSIER_TECHNIQUE")
  description         String? // Description détaillée optionnelle
  // Textes pour le rapport selon le résultat
  conformeText        String // Texte professionnel si CONFORME
  nonConformeText     String // Texte d'alerte si NON_CONFORME
  regulatoryReference String? // Référence réglementaire (ex: "Article R.224-41-4")
  sortOrder           Int      @default(0)
  isRequired          Boolean  @default(false) // Si requis pour validation
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  template        ChecklistTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recommendations RecommendationTemplate[] // Recommandations par défaut pour cet item

  @@unique([templateId, itemKey])
  @@index([templateId])
  @@index([category])
  @@map("checklist_template_items")
}

// Template de recommandation (action corrective par défaut)
model RecommendationTemplate {
  id              String   @id @default(cuid())
  organizationId  String
  checklistItemId String? // Liée à un item de checklist (optionnel)
  title           String // Ex: "Mise en place du schéma de principe"
  description     String // Description détaillée de l'action
  defaultCostMin  Float? // Estimation de coût minimum (€ HT)
  defaultCostMax  Float? // Estimation de coût maximum (€ HT)
  priority        Int      @default(3) // 1=Urgent, 2=Court terme, 3=Moyen terme, 4=Long terme
  category        String? // Catégorie (ex: "MAINTENANCE", "REMPLACEMENT", "REGLEMENTAIRE")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklistItem        ChecklistTemplateItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  auditRecommendations AuditRecommendation[]

  @@index([organizationId])
  @@index([checklistItemId])
  @@map("recommendation_templates")
}

// ============================================
// PLAN DE RENOUVELLEMENT CONTRACTUEL (P3)
// ============================================

enum RenewalItemSource {
  PLAN_INITIAL // plan contractuel d'origine
  AVENANT // ajouté par avenant
  DEVIS_P3 // issu d'un devis P3 accepté
}

enum RenewalItemStatus {
  PREVU
  REALISE
  REPORTE
  ABANDONNE
}

// Poste du plan de renouvellement contractuel (P3) — la référence
// métier de la carte Renouvellement (jamais la théorie seule)
model ContractRenewalItem {
  id             String            @id @default(cuid())
  contractId     String
  organizationId String
  equipmentId    String? // rattachement facultatif à l'inventaire
  siteId         String? // ou poste générique rattaché au site
  quoteId        String? // devis P3 qui réalise le poste (rapprochement plan ↔ réalisé)
  label          String // ex: "Remplacement chaudière n°1"
  plannedYear    Int // année de programmation au contrat
  amountHT       Float // montant prévu au plan (€ HT)
  source         RenewalItemSource @default(PLAN_INITIAL)
  status         RenewalItemStatus @default(PREVU)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([contractId, plannedYear])
  @@index([organizationId])
  @@index([equipmentId])
  @@index([quoteId])
  @@index([status])
  @@map("contract_renewal_items")
}

// Recommandation générée lors d'un audit (instance)
model AuditRecommendation {
  id               String    @id @default(cuid())
  technicalAuditId String
  equipmentId      String? // équipement concerné (facultatif)
  templateId       String? // Template source (null si créée manuellement)
  checklistItemKey String? // Clé de l'item de checklist concerné
  title            String
  description      String
  estimatedCostMin Float? // Coût estimé min (modifiable par l'auditeur)
  estimatedCostMax Float? // Coût estimé max
  actualCost       Float? // Coût réel si travaux effectués
  priority         Int       @default(3) // 1=Urgent, 2=Court terme, 3=Moyen terme, 4=Long terme
  status           String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  auditorNotes     String? // Notes de l'auditeur
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  technicalAudit TechnicalAudit          @relation(fields: [technicalAuditId], references: [id], onDelete: Cascade)
  equipment      Equipment?              @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  template       RecommendationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([technicalAuditId])
  @@index([equipmentId])
  @@index([status])
  @@map("audit_recommendations")
}

// Catégories personnalisables pour les checklists
model ChecklistCategory {
  id             String   @id @default(cuid())
  organizationId String
  key            String // Ex: "DOSSIER_TECHNIQUE", "COMBUSTION"
  label          String // Ex: "Dossier technique", "Combustion"
  description    String?
  sortOrder      Int      @default(0)
  icon           String? // Nom d'icône optionnel (lucide-react)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("checklist_categories")
}

// ============================================
// NOUVEAU SYSTÈME D'AUDIT CONFIGURABLE
// ============================================

// Bibliothèque de préconisations (réutilisable)
model RecommendationLibrary {
  id             String   @id @default(cuid())
  organizationId String
  title          String // "Mise en place schéma de principe"
  description    String?
  price          Float? // 750
  priceUnit      String   @default("HT") // "HT", "TTC"
  category       String? // Pour organiser: "DOCUMENTATION", "COMBUSTION", etc.
  priority       Int      @default(3) // 1=Urgent, 2=Court terme, 3=Moyen terme, 4=Long terme
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
  @@map("recommendation_library")
}

// Point de contrôle d'audit configurable
model AuditCheckPoint {
  id             String @id @default(cuid())
  organizationId String

  // Identification
  label       String // "Schéma de principe"
  category    String // "REGLEMENTAIRE", "CONFORMITE", "SECURITE", "PERIODIQUE"
  description String?

  // Type de réponse
  // "YES_NO" - Simple oui/non
  // "MULTI_CHOICE" - Choix multiples avec préconisations différentes
  // "YES_NO_DATE" - Oui/non + date si oui
  // "YES_NO_VALUES" - Oui/non + valeurs à saisir si oui (ex: analyse combustion)
  responseType String @default("MULTI_CHOICE")

  // Constats possibles (JSON)
  // Format:
  // [
  //   {
  //     "id": "present_ok",
  //     "label": "Présent et affiché",
  //     "isConform": true,
  //     "reportText": "Le schéma est présent et correctement affiché"
  //   },
  //   {
  //     "id": "absent",
  //     "label": "Absent",
  //     "isConform": false,
  //     "recommendationId": "clxxx",
  //     "reportText": "Absence de schéma de principe"
  //   },
  //   {
  //     "id": "not_updated",
  //     "label": "Présent mais pas à jour",
  //     "isConform": false,
  //     "recommendationId": "clyyy",
  //     "reportText": "Schéma de principe non mis à jour"
  //   }
  // ]
  findings Json @default("[]")

  // Configuration pour réponses avec valeurs (YES_NO_VALUES)
  // [
  //   { "name": "date", "label": "Date de réalisation", "type": "date", "required": true },
  //   { "name": "co", "label": "CO (ppm)", "type": "number", "maxThreshold": 50, "outOfRangeRecommendationId": "clxxx" },
  //   { "name": "co2", "label": "CO2 (%)", "type": "number", "minThreshold": 8, "maxThreshold": 12 },
  //   { "name": "rendement", "label": "Rendement (%)", "type": "number", "minThreshold": 90 }
  // ]
  valueFields Json?

  // Référence réglementaire (affichée dans le rapport si non conforme)
  regulatoryRef String? // "Article R.224-41-4 du Code de l'environnement"

  // Ordre et état
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
  @@map("audit_check_points")
}

// ============================================
// BASSINS DE PISCINE
// ============================================

// Type de bassin
enum PoolBasinType {
  BASSIN_SPORTIF // Bassin de nage 25m/50m
  BASSIN_APPRENTISSAGE // Bassin d'apprentissage (faible profondeur)
  BASSIN_LUDIQUE // Bassin ludique / loisirs
  PATAUGEOIRE // Pataugeoire enfants
  FOSSE_PLONGEE // Fosse de plongée
  BASSIN_NORDIQUE // Bassin nordique (extérieur chauffé)
  BASSIN_EXTERIEUR // Bassin extérieur non chauffé
  SPA_JACUZZI // Spa / Jacuzzi / Bain bouillonnant
  TOBOGGAN // Réception toboggan
  RIVIERE // Rivière à courant
  AUTRE
}

// Type de traitement d'eau
enum PoolTreatmentType {
  CHLORE // Chlore liquide ou galets
  BROME // Brome
  SEL // Électrolyse au sel
  UV // Traitement UV
  OZONE // Ozonation
  CHLORE_UV // Chlore + UV
  CHLORE_OZONE // Chlore + Ozone
  SEL_UV // Sel + UV
  AUTRE
}

// Type de filtration
enum PoolFiltrationType {
  SABLE // Filtre à sable
  VERRE // Média filtrant verre
  DIATOMEE // Diatomées
  CARTOUCHE // Cartouches
  PRECOAT // Précoat
  AUTRE
}

// Modèle Bassin de piscine (plusieurs bassins par site)
model PoolBasin {
  id              String             @id @default(cuid())
  siteId          String
  name            String // Nom du bassin (ex: "Grand bassin", "Pataugeoire")
  type            PoolBasinType
  // Dimensions
  volume          Float // Volume en m³
  surface         Float? // Surface en m²
  length          Float? // Longueur en m
  width           Float? // Largeur en m
  depthMin        Float? // Profondeur min en m
  depthMax        Float? // Profondeur max en m
  // Configuration
  indoor          Boolean            @default(true) // Intérieur ou extérieur
  heated          Boolean            @default(true) // Chauffé ou non
  targetTemp      Float? // Température cible en °C (ex: 28°C)
  // Traitement et filtration
  treatmentType   PoolTreatmentType  @default(CHLORE)
  filtrationType  PoolFiltrationType @default(SABLE)
  // Usage et fréquentation
  usage           String? // "public", "scolaire", "competition", "loisir"
  avgDailyBathers Int? // Fréquentation moyenne jour
  weeksPerYear    Int?               @default(40) // Semaines d'ouverture/an
  // Notes
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("pool_basins")
}

// ============================================
// CONTRATS
// ============================================

enum ContractType {
  MTI // Marché Tout Inclus (P1+P2+P3)
  MCI // Marché Chauffage Installation
  PFI // Performance et Financement Installation
  CPI // Conception Performance Installation
  MT // Maintenance seule (P2)
  CP // Contrat de Performance
  PF // Performance Forfaitaire
  MC // Marché de Chauffage
  MF // Marché Forfaitaire
  AUTRE
}

enum ContractStatus {
  ACTIF
  EXPIRE
  EN_ATTENTE
  RESILIE
}

// Type d'année contractuelle (pour le calcul des prorata)
enum ContractYearType {
  CIVIL // Année civile: 01/01 - 31/12
  HEATING_SEASON // Saison de chauffe: configurable (ex: 01/07 - 30/06)
  CONTRACTUAL // Année contractuelle: débute à la date anniversaire du contrat
}

// Fréquence de facturation
enum BillingFrequency {
  MENSUEL // 12 échéances par an
  TRIMESTRIEL // 4 échéances par an (défaut)
  SEMESTRIEL // 2 échéances par an
  ANNUEL // 1 échéance par an
}

model Contract {
  id               String           @id @default(cuid())
  reference        String
  title            String
  provider         String // Exploitant (ENGIE, Dalkia, etc.)
  providerEmail    String? // Email de contact de l'exploitant (envoi des devis acceptés)
  startDate        DateTime
  endDate          DateTime
  status           ContractStatus   @default(ACTIF)
  description      String?
  documentUrl      String?
  // Type d'année contractuelle (saison de chauffe par défaut: 01/07 - 30/06)
  yearType         ContractYearType @default(HEATING_SEASON)
  yearStartMonth   Int              @default(7) // Mois de début (1-12), 7 = juillet
  yearStartDay     Int              @default(1) // Jour de début (1-31)
  // DJU contractuels (paramètre global du contrat, importé depuis l'AE)
  djuContractuel   Float?
  // Fréquence de facturation
  billingFrequency BillingFrequency @default(TRIMESTRIEL)
  // Secteur : public (collectivité) ou privé. En public, P4 (financement) est interdit.
  // Défaut false (privé) pour ne pas modifier les contrats existants ; le formulaire de création pré-sélectionne Public.
  isPublic         Boolean          @default(false)
  organizationId   String
  clientId         String? // Client (collectivité) rattaché
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  contractSites    ContractSite[] // Relation explicite avec les sites
  avenants         Avenant[] // Avenants du contrat
  revisionIndices  ContractRevisionIndex[]
  revisionFormulas ContractRevisionFormula[]
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoices         Invoice[]
  quotes           Quote[]
  renewalItems     ContractRenewalItem[]
  tickets          Ticket[]
  meetings         Meeting[]
  userAssignments  UserContractAssignment[] // Assignations ingénieurs
  missionContracts MissionContract[] // Missions rattachées

  @@index([organizationId])
  @@index([clientId])
  @@map("contracts")
}

// Table pivot pour la relation Contract-Site avec type et prestations par site
model ContractSite {
  id              String       @id @default(cuid())
  contractId      String
  siteId          String
  contractType    ContractType @default(MC) // Type de contrat pour CE site
  hasP1           Boolean      @default(false) // P1 - Combustible/Énergie
  hasP2           Boolean      @default(false) // P2 - Petit entretien
  hasP3           Boolean      @default(false) // P3 - Gros entretien/Renouvellement
  hasP4           Boolean      @default(false) // P4 - Financement
  amountP1        Float? // Forfait P1 de base pour ce site
  amountP2        Float? // Forfait P2 de base pour ce site (total)
  amountP3        Float? // Forfait P3 de base pour ce site (total)
  amountP1Base    Float? // P1 initial (référence pour révision indicielle, P_0)
  amountP2Base    Float? // P2 initial (référence pour révision indicielle, P_0)
  amountP3Base    Float? // P3 initial (référence pour révision indicielle, P_0)
  // === DETAIL P2 - Petit entretien par poste (€HT annuel) ===
  amountP21       Float? // P2 01 - Chauffage
  amountP22       Float? // P2 02 - Ventilation
  amountP23       Float? // P2 03 - Climatisation
  amountP24       Float? // P2 04 - ECS
  amountP25       Float? // P2 05 - Traitement d'eau
  amountP26       Float? // P2 06 - MDE (Maîtrise de l'énergie)
  amountP27       Float? // P2 07 - Sous-composante 7
  amountP28       Float? // P2 08 - Sous-composante 8
  amountP29       Float? // P2 09 - Sous-composante 9
  amountP210      Float? // P2 10 - Sous-composante 10
  // === DETAIL P3 - Gros entretien par poste (€HT annuel) ===
  amountP31       Float? // P3 01 - Chauffage
  amountP32       Float? // P3 02 - Ventilation
  amountP33       Float? // P3 03 - Climatisation
  amountP34       Float? // P3 04 - ECS et traitement d'eau
  amountP35       Float? // P3 05 - Prestations programmées
  amountP36       Float? // P3 06 - APE (Actions Préventives Extraordinaires)
  amountP37       Float? // P3 07 - Sous-composante 7
  amountP38       Float? // P3 08 - Sous-composante 8
  amountP39       Float? // P3 09 - Sous-composante 9
  amountP310      Float? // P3 10 - Sous-composante 10
  // Date d'intégration dans le contrat (pour les ajouts via avenant)
  integrationDate DateTime? // Si null, c'est depuis le début du contrat
  // Date de sortie du contrat (pour les retraits via avenant)
  exitDate        DateTime? // Si renseigné, le site sort du contrat à cette date
  avenantEntreeId String? // Avenant d'entrée (si ajouté après le début)
  avenantSortieId String? // Avenant de sortie (si retiré)

  // === COEFFICIENTS ENERGETIQUES ===
  // Coefficient Q : énergie pour produire 1m³ d'ECS (MWh/m³)
  // Varie selon T° eau froide, T° ECS, rendement. Typiquement 0.10 à 0.14
  coefficientQ       Float? @default(0.13)
  // Coefficient PCS : Pouvoir Calorifique Supérieur du gaz (kWh/m³)
  // 20 mbar (basse pression): ~10.5 kWh/m³, 300 mbar (moyenne pression): ~14.5 kWh/m³
  coefficientPCS     Float? @default(10.5)
  // Rendement chaudière (pour calculs avancés)
  rendementChaudiere Float? @default(0.90)

  // === ANALYSE EAU PISCINE ===
  // Configuration des passages d'analyse d'eau pour les bassins (piscines)
  poolAnalysisEnabled         Boolean @default(false) // Analyse d'eau activée pour ce site
  poolAnalysisPerDay          Int? // Nombre d'analyses par jour (1, 2, 3...)
  poolAnalysisDaysPerWeek     Int? // Jours par semaine (7=quotidien, 5=semaine, etc.)
  poolAnalysisWeeksPerYear    Int? // Semaines par an (ex: 40 si piscine fermée 12 semaines)
  poolAnalysisMinutesPerVisit Int?    @default(30) // Durée par passage en minutes

  // === BARÈME P1 (décompte MTI) — valeurs de base €HT/MWh PCS ===
  // Prix unitaires de base (P_0) servant au coef de révision indicielle additif (Σrev/Σbase).
  // Parsés depuis la DPGF à la création du contrat. P0 = marge exploitant (NON révisée).
  p1Peg0     Float? // PEG base €HT/MWh PCS
  p1Ticgn0   Float? // TICGN base €HT/MWh PCS
  p1Tvd0     Float? // TVD base €HT/MWh PCS (dépend du tarif T1-T4)
  p1Cee0     Float? // CEE base €HT/MWh PCS
  p1P0Unit   Float? // P0 marge exploitant €HT/MWh (non révisé)
  p1TvdTarif TvdTarif? // Tarif de distribution GRDF du site (pour la révision TVD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contract      Contract                  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  site          Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  avenantEntree Avenant?                  @relation("SiteEntree", fields: [avenantEntreeId], references: [id])
  avenantSortie Avenant?                  @relation("SiteSortie", fields: [avenantSortieId], references: [id])
  priceChanges  ContractSitePriceChange[] // Historique des changements de prix
  avenantItems  AvenantItem[] // Modifications d'avenant concernant ce site

  @@unique([contractId, siteId]) // Un site ne peut être qu'une fois dans un contrat
  @@index([siteId]) // le sens contractId est déjà couvert par @@unique
  @@map("contract_sites")
}

// ============================================
// AVENANTS (Modifications contractuelles)
// ============================================

// Tarif de distribution gaz GRDF (par site, selon volume) — sélectionne la série TVD pour la révision P1
enum TvdTarif {
  T1
  T2
  T3
  T4
}

// Type de modification dans un avenant
enum AvenantItemType {
  AJOUT_SITE // Ajout d'un site au contrat
  RETRAIT_SITE // Retrait d'un site du contrat
  AJOUT_EQUIPEMENT // Ajout d'équipement avec impact financier
  RETRAIT_EQUIPEMENT // Retrait d'équipement avec impact financier
  MODIFICATION_PRIX_P1 // Changement de prix P1
  MODIFICATION_PRIX_P2 // Changement de prix P2
  MODIFICATION_PRIX_P3 // Changement de prix P3
  AJOUT_PRESTATION // Ajout de prestation (P1, P2, P3, P4)
  RETRAIT_PRESTATION // Retrait de prestation
  AUTRE
}

// Avenant = conteneur de modifications
model Avenant {
  id            String    @id @default(cuid())
  contractId    String
  reference     String // Ex: "Avenant n°1", "AV-2024-001"
  signatureDate DateTime? // Date de signature de l'avenant
  description   String? // Description générale de l'avenant
  documentUrl   String? // Lien vers le document de l'avenant
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  contract     Contract                  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  items        AvenantItem[] // Les différentes modifications de cet avenant
  sitesEntrees ContractSite[]            @relation("SiteEntree") // Sites ajoutés par cet avenant
  sitesSorties ContractSite[]            @relation("SiteSortie") // Sites retirés par cet avenant
  priceChanges ContractSitePriceChange[] // Changements de prix liés à cet avenant (legacy)

  @@map("avenants")
}

// Chaque modification dans un avenant
model AvenantItem {
  id             String          @id @default(cuid())
  avenantId      String
  type           AvenantItemType
  effectiveDate  DateTime // Date d'effet de CETTE modification
  description    String? // Description de cette modification
  // Entités concernées
  contractSiteId String? // Si la modification concerne un site
  equipmentId    String? // Si la modification concerne un équipement
  // Incidence financière de cette modification (delta annuel)
  deltaP1        Float? // +/- montant P1 annuel
  deltaP2        Float? // +/- montant P2 annuel
  deltaP3        Float? // +/- montant P3 annuel
  // Nouveaux montants après modification (pour historique)
  newAmountP1    Float?
  newAmountP2    Float?
  newAmountP3    Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  avenant      Avenant       @relation(fields: [avenantId], references: [id], onDelete: Cascade)
  contractSite ContractSite? @relation(fields: [contractSiteId], references: [id])
  equipment    Equipment?    @relation(fields: [equipmentId], references: [id])

  @@map("avenant_items")
}

// Historique des changements de prix pour un site dans un contrat
model ContractSitePriceChange {
  id             String   @id @default(cuid())
  contractSiteId String
  avenantId      String? // Avenant à l'origine du changement (null = prix initial)
  effectiveDate  DateTime // Date d'effet du changement
  // Nouveaux montants après ce changement
  amountP1       Float? // Nouveau P1 annuel
  amountP2       Float? // Nouveau P2 annuel
  amountP3       Float? // Nouveau P3 annuel
  // Delta pour calculer le prorata de l'année
  deltaP1        Float? // +/- montant P1 (pour calcul prorata)
  deltaP2        Float? // +/- montant P2 (pour calcul prorata)
  deltaP3        Float? // +/- montant P3 (pour calcul prorata)
  reason         String? // Ex: "Ajout chaudière 300kW", "Remplacement VMC"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  contractSite ContractSite @relation(fields: [contractSiteId], references: [id], onDelete: Cascade)
  avenant      Avenant?     @relation(fields: [avenantId], references: [id])

  @@map("contract_site_price_changes")
}

// ============================================
// REVISION INDICIELLE (P1/P2/P3)
// ============================================

enum RevisionPType {
  P1
  P2
  P3
}

enum RevisionPeriod {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

model ContractRevisionIndex {
  id         String   @id @default(cuid())
  contractId String
  name       String // "BT40", "ICHT-IME", ...
  identifier String? // Identifiant INSEE (ex: "001710973")
  createdAt  DateTime @default(now())

  contract   Contract                     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  values     ContractRevisionIndexValue[]
  components ContractFormulaComponent[]

  @@unique([contractId, name])
  @@map("contract_revision_indices")
}

model ContractRevisionIndexValue {
  id            String   @id @default(cuid())
  indexId       String
  date          DateTime // date d'effet
  value         Float
  isProvisional Boolean  @default(false) // valeur provisoire (à confirmer)

  index ContractRevisionIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, date])
  @@map("contract_revision_index_values")
}

model ContractRevisionFormula {
  id           String         @id @default(cuid())
  contractId   String
  pType        RevisionPType
  periodicity      RevisionPeriod @default(ANNUAL)
  baseDate         DateTime
  constantPart     Float          @default(0)
  roundingDecimals Int            @default(4) // arrondi du coefficient K
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  contract   Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  components ContractFormulaComponent[]

  @@unique([contractId, pType])
  @@map("contract_revision_formulas")
}

model ContractFormulaComponent {
  id               String @id @default(cuid())
  formulaId        String
  indexId          String
  coefficient      Float
  baseValue        Float // I_0 stocké explicitement
  reconnectionCoef Float  @default(1) // coef raccordement si changement de base INSEE

  formula ContractRevisionFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  index   ContractRevisionIndex   @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@map("contract_formula_components")
}

// ============================================
// CONSOMMATIONS ENERGETIQUES
// ============================================

model Consumption {
  id                String            @id @default(cuid())
  siteId            String
  organizationId    String
  energyType        EnergyType
  usage             EnergyUsage       @default(MIXTE) // Chauffage, ECS, Mixte
  source            ConsumptionSource @default(MANUAL) // Origine de la donnée
  period            DateTime // Mois ou date de consommation
  periodEnd         DateTime? // Fin de période (relevés exploitant à dates irrégulières)
  quantity          Float // kWh ou m³ ou litres
  unit              String // kWh, m³, L
  cost              Float? // Coût en €
  djuReel           Float? // DJU Réels de la période (pour calcul N'B)
  meterName         String? // Nom du compteur (ex: "CPT GAZ GrDF BESSON")
  // Champs calculés (optionnel, pour cache)
  quantityEcs       Float? // Part ECS déduite (si MIXTE)
  quantityChauffage Float? // Part Chauffage (si MIXTE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([siteId, energyType, usage, period, source])
  @@index([organizationId, period]) // analytics de consommation
  @@map("consumptions")
}

enum ConsumptionSource {
  TELERELEVE // Données automatiques GRDF/Enedis
  EXPLOITANT // Relevés manuels exploitant (import IDEX, etc.)
  MANUAL // Saisie manuelle par l'utilisateur
}

// ============================================
// SAISONS DE CHAUFFAGE (dates d'allumage/arrêt par site)
// ============================================

model HeatingSeason {
  id             String    @id @default(cuid())
  siteId         String
  season         String // Ex: "2024-2025" (année de départ - année de fin)
  startDate      DateTime? // Date d'allumage du chauffage (null si pas encore défini)
  endDate        DateTime? // Date d'arrêt (null si pas encore arrêté)
  lastReleveDate DateTime? // Date du dernier relevé importé (pour calcul DJU)
  // Engagement énergétique de la saison (peut varier avec APE)
  nb             Float? // NB de la saison (MWh) - si null, utilise le NB du site
  nbUnit         NbUnit? // Unité du NB (PCS ou Utile)
  djuContractuel Float? // DJU contractuels de la saison (si différent du site)
  // Index compteur au démarrage (optionnel, pour relevé initial)
  startIndex     Float? // Index compteur gaz/énergie au démarrage
  startIndexUnit String? // Unité de l'index (m³, kWh)
  // Index compteur à l'arrêt (optionnel)
  endIndex       Float? // Index compteur à l'arrêt
  // Notes
  notes          String? // Remarques sur la mise en route/arrêt, APE appliquée, etc.
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, season]) // Une seule saison par site par année
  @@index([siteId])
  @@index([season])
  @@map("heating_seasons")
}

// Période de chauffe (allumage / arrêt)
// Modèle dédié aux dates d'exploitation, séparé de HeatingSeason (qui garde le NB).
// Un site peut avoir plusieurs périodes par an (ex: CIVIL 2025 = fin saison 24-25 + début saison 25-26).
model HeatingPeriod {
  id        String    @id @default(cuid())
  siteId    String
  startDate DateTime // Date d'allumage du chauffage
  endDate   DateTime? // Date d'arrêt (null si saison en cours)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([startDate])
  @@map("heating_periods")
}

// ============================================
// COMPTEURS ET RELEVES
// ============================================

// Type de compteur
enum MeterType {
  PRINCIPAL // Compteur distributeur (GRDF/Enedis) - source API
  DIVISIONNAIRE // Sous-compteur (relevé exploitant)
}

// Fluide/énergie mesuré
enum MeterFluid {
  GAZ // Compteur gaz (m³)
  ELECTRICITE // Compteur électrique (kWh)
  EAU_CHAUDE // Compteur ECS volumétrique (m³)
  EAU_FROIDE // Compteur eau froide (m³)
  CHALEUR // Compteur calorifique (kWh/MWh)
  FIOUL // Jauge fioul (litres)
}

// Source des données
enum MeterDataSource {
  API // Données télérelevées (GRDF/Enedis)
  MANUEL // Relevé exploitant
}

// Compteur (principal ou sous-compteur)
model Meter {
  id         String          @id @default(cuid())
  siteId     String
  name       String // Ex: "Compteur gaz principal", "Sous-compteur ECS bâtiment A"
  reference  String? // PCE, PDL, ou numéro série interne
  type       MeterType       @default(DIVISIONNAIRE)
  fluid      MeterFluid
  dataSource MeterDataSource @default(MANUEL)
  unit       String          @default("m3") // m³, kWh, MWh, L

  // Hiérarchie (sous-compteur rattaché à un principal)
  parentId String?
  parent   Meter?  @relation("MeterHierarchy", fields: [parentId], references: [id])
  children Meter[] @relation("MeterHierarchy")

  // Pour le calcul chauffage : ce compteur est-il déduit du principal ?
  // Ex: ECS déduit du gaz total pour obtenir le chauffage
  isDeductedFromParent Boolean @default(false)

  // Coefficient de conversion (si applicable)
  // Ex: pour ECS volumétrique → énergie : coefficient Q
  conversionCoefficient Float? // Ex: 0.12 MWh/m³ pour ECS
  conversionUnit        String? // Unité après conversion (ex: "MWh")

  // Actif ou non
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  site     Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  readings MeterReading[]

  @@index([siteId])
  @@map("meters")
}

// Relevé de compteur
model MeterReading {
  id      String @id @default(cuid())
  meterId String

  // Date et période
  readingDate DateTime // Date du relevé
  periodStart DateTime? // Début de période (pour conso)
  periodEnd   DateTime? // Fin de période (pour conso)

  // Valeurs
  indexValue  Float? // Index compteur (si relevé d'index)
  consumption Float? // Consommation sur la période
  unit        String @default("m3") // Unité de la valeur

  // Valeur convertie (si coefficient appliqué)
  consumptionConverted Float? // Ex: m³ ECS → MWh
  unitConverted        String? // Unité après conversion

  // Source et validation
  source      MeterDataSource // API ou MANUEL
  isValidated Boolean         @default(false) // Validé par l'AMO/client
  validatedAt DateTime?
  validatedBy String? // Nom du validateur

  // Marqueur "nouveau compteur" — quand le compteur est remplacé,
  // ce relevé est le premier du nouveau compteur (pas de calcul de conso
  // avec le relevé précédent du compteur remplacé)
  isReset Boolean @default(false)

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@unique([meterId, readingDate])
  @@index([meterId])
  @@index([readingDate])
  @@index([periodStart, periodEnd])
  @@map("meter_readings")
}

// ============================================
// FACTURES
// ============================================

enum InvoiceStatus {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

enum InvoiceType {
  P1
  P2
  P3
  TRAVAUX
  AUTRE
}

model Invoice {
  id             String        @id @default(cuid())
  reference      String
  type           InvoiceType
  status         InvoiceStatus @default(EN_ATTENTE)
  amount         Float
  taxAmount      Float?
  issueDate      DateTime
  dueDate        DateTime
  paidDate       DateTime?
  description    String?
  p1SubType      String?
  documentUrl    String?
  siteId         String?
  contractId     String?
  organizationId String
  acceptedBy     String?
  acceptedAt     DateTime?
  refusedBy      String?
  refusedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contract       Contract?    @relation(fields: [contractId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptedByUser User?        @relation("InvoiceAcceptedBy", fields: [acceptedBy], references: [id])
  refusedByUser  User?        @relation("InvoiceRefusedBy", fields: [refusedBy], references: [id])

  @@index([organizationId, issueDate(sort: Desc)]) // liste principale
  @@index([contractId])
  @@index([siteId])
  @@map("invoices")
}

// ============================================
// DEVIS
// ============================================

enum QuoteStatus {
  BROUILLON // Devis en cours de création
  EN_ATTENTE // Devis reçu, en attente de décision
  ACCEPTE // Devis accepté
  REFUSE // Devis refusé
  EXPIRE // Devis expiré
  COMMANDE // Transformé en commande
  FACTURE // Facturé
}

enum QuoteType {
  P3 // Maintenance préventive (GER)
  P5 // Gros travaux
}

model Quote {
  id         String      @id @default(cuid())
  reference  String
  title      String
  provider   String // Fournisseur (ex: T.É.P.I. EXPLOITATION)
  client     String? // Client facturé (ex: IDEX ENERGIES)
  quoteType  QuoteType? // Type: P3, P5, Astreinte
  amountHT   Float       @default(0) // Montant HT
  amountTVA  Float? // Montant TVA
  amountTTC  Float       @default(0) // Montant TTC
  status     QuoteStatus @default(BROUILLON)
  issueDate  DateTime    @default(now()) // Date d'émission
  validUntil DateTime? // Date de validité (optionnel)

  // Décision
  acceptedBy String? // ID de l'utilisateur qui a accepté
  acceptedAt DateTime? // Date d'acceptation
  refusedBy  String? // ID de l'utilisateur qui a refusé
  refusedAt  DateTime? // Date de refus

  description    String?
  documentUrl    String? // URL du PDF original
  siteId         String? // Site concerné
  contractId     String? // Contrat lié
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?        @relation(fields: [siteId], references: [id])
  contract       Contract?    @relation(fields: [contractId], references: [id])
  items          QuoteItem[]
  workOrder      WorkOrder? // Suivi de l'exécution des travaux
  renewalItems   ContractRenewalItem[] // Postes de plan P3 réalisés par ce devis
  acceptedByUser User?        @relation("QuoteAcceptedBy", fields: [acceptedBy], references: [id], onDelete: SetNull)
  refusedByUser  User?        @relation("QuoteRefusedBy", fields: [refusedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, issueDate(sort: Desc)]) // liste principale
  @@index([contractId])
  @@index([siteId])
  @@map("quotes")
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  lineNumber  Int // Numéro de ligne
  description String // Description du poste
  quantity    Float // Quantité
  unit        String // Unité (HEUR, FORF, KG, U, etc.)
  unitPrice   Float // Prix unitaire HT
  totalHT     Float // Montant HT de la ligne
  tvaRate     Float? // Taux de TVA (ex: 20.00)

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

// ============================================
// CONTRÔLES RÉGLEMENTAIRES CVC
// ============================================

enum RegulatoryCategory {
  COMBUSTION // Contrôle combustion, ramonage
  GAZ // Vérification installation gaz
  LEGIONELLE // Analyse légionelle, carnet sanitaire
  FLUIDE_FRIGORIGENE // Étanchéité fluide frigorigène
  ELECTRIQUE // Vérification installation électrique
  AERAULIQUE // Contrôle aéraulique, filtres, débits
  PRESSION // Appareils à pression, disconnecteurs
  TOUR_AERO // Tours aéroréfrigérantes
  INCENDIE // Sécurité incendie, désenfumage
  EAU // Qualité eau, traitement eau
  AUTRE
}

enum ControlFrequency {
  MENSUEL // Tous les mois
  TRIMESTRIEL // Tous les 3 mois
  SEMESTRIEL // Tous les 6 mois
  ANNUEL // Tous les ans
  BIENNAL // Tous les 2 ans
  TRIENNAL // Tous les 3 ans
  QUINQUENNAL // Tous les 5 ans
  PONCTUEL // Unique / à la demande
}

enum ControlStatus {
  A_PLANIFIER // Pas encore planifié
  PLANIFIE // Date d'intervention prévue
  EFFECTUE // Contrôle réalisé
  EN_RETARD // Échéance dépassée
  NON_APPLICABLE // Ne s'applique plus
}

enum ControlResult {
  CONFORME
  NON_CONFORME
  AVEC_RESERVES // Conforme sous réserve
  EN_ATTENTE // Résultat en attente (ex: analyse labo)
}

/// Type de contrôle réglementaire (template configurable par organisation)
/// Ex: "Ramonage conduit fumée", "Analyse légionelle ECS", "Vérification gaz"
model RegulatoryControlType {
  id                String             @id @default(cuid())
  organizationId    String
  name              String // Ex: "Ramonage conduit fumée"
  category          RegulatoryCategory
  description       String? // Détail du contrôle
  regulatoryRef     String? // Référence légale (ex: "Arrêté du 15/09/2009")
  frequency         ControlFrequency   @default(ANNUEL)
  frequencyMonths   Int                @default(12) // Pour calcul précis de la prochaine échéance
  /// Domaines d'équipements concernés (filtre pour savoir quels sites sont impactés)
  applicableDomains EquipmentDomain[] // Ex: [CHAUFFAGE] pour ramonage
  /// Seuils d'applicabilité
  minPowerKw        Float? // Applicable si puissance >= X kW (ex: 400kW pour inspection chaudière)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls     RegulatoryControl[]

  @@index([organizationId])
  @@map("regulatory_control_types")
}

/// Instance d'un contrôle réglementaire à réaliser ou réalisé
model RegulatoryControl {
  id             String  @id @default(cuid())
  typeId         String
  siteId         String
  equipmentId    String? // Optionnel : équipement spécifique concerné
  organizationId String

  // Planification
  dueDate DateTime // Échéance réglementaire
  status  ControlStatus @default(A_PLANIFIER)

  // Réalisation
  performedDate DateTime? // Date effective du contrôle
  performer     String? // Entreprise/technicien (ex: "Dekra", "Bureau Veritas")
  result        ControlResult?
  reportUrl     String? // Lien vers le rapport/attestation
  notes         String? // Observations, non-conformités relevées

  // Prochaine échéance (calculée après réalisation)
  nextDueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  type         RegulatoryControlType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  site         Site                  @relation(fields: [siteId], references: [id])
  equipment    Equipment?            @relation(fields: [equipmentId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([siteId])
  @@index([typeId])
  @@index([status])
  @@index([dueDate])
  @@map("regulatory_controls")
}

// ============================================
// TICKETS / POINTS DE SUIVI
// ============================================

enum TicketSource {
  EMAIL
  MEETING
  VISIT
  PHONE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id             String       @id @default(cuid())
  reference      String       @unique // Format : TKT-2026-0001
  organizationId String
  siteId         String
  contractId     String?
  title          String
  description    String?
  source         TicketSource @default(EMAIL)
  status         TicketStatus @default(OPEN)
  responsible    String? // Texte libre : "IDEX", "Mairie", "AMO"
  dueDate        DateTime? // Échéance pour relances
  openedAt       DateTime     @default(now())
  resolvedAt     DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site                @relation(fields: [siteId], references: [id])
  contract     Contract?           @relation(fields: [contractId], references: [id])
  createdBy    User?               @relation("TicketCreatedBy", fields: [createdById], references: [id])
  agendaItems  MeetingAgendaItem[]

  @@index([organizationId])
  @@index([siteId])
  @@index([contractId])
  @@index([status])
  @@map("tickets")
}

// ============================================
// REUNIONS D'EXPLOITATION
// ============================================

enum MeetingType {
  EXPLOITATION
  TRAVAUX
  BILAN_ANNUEL
  URGENCE
  AUTRE
}

model Meeting {
  id             String      @id @default(cuid())
  title          String
  type           MeetingType
  date           DateTime
  location       String?
  attendees      String[] // Liste des participants
  agenda         String? // Ordre du jour (texte libre legacy)
  notes          String? // Compte-rendu (texte libre legacy)
  siteId         String?
  contractId     String? // Contrat lié (pour filtrer les tickets)
  organizationId String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  site         Site?               @relation(fields: [siteId], references: [id])
  contract     Contract?           @relation(fields: [contractId], references: [id])
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workLevees   WorkLevee[] // Levées de réserves liées à cette réunion
  agendaItems  MeetingAgendaItem[] // ODJ structuré

  @@index([contractId])
  @@map("meetings")
}

model MeetingAgendaItem {
  id        String  @id @default(cuid())
  meetingId String
  ticketId  String? // null = point libre (pas lié à un ticket)
  order     Int // Position dans l'ODJ
  title     String // Auto-rempli depuis ticket.title ou libre
  notes     String? // Notes prises pendant la réunion
  decision  String? // Décision actée

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  ticket  Ticket? @relation(fields: [ticketId], references: [id])

  @@index([meetingId])
  @@map("meeting_agenda_items")
}

// ============================================
// ALERTES
// ============================================

enum AlertType {
  DERIVE_CONSOMMATION
  CONTRAT_EXPIRATION
  FACTURE_ECHEANCE
  EQUIPEMENT_MAINTENANCE
  EQUIPEMENT_PANNE
  AUTRE
}

enum AlertPriority {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}

model Alert {
  id             String        @id @default(cuid())
  type           AlertType
  priority       AlertPriority @default(MOYENNE)
  title          String
  message        String
  isRead         Boolean       @default(false)
  siteId         String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  site         Site?        @relation(fields: [siteId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([siteId])
  @@map("alerts")
}

// ============================================
// TELERELEVE - Fournisseurs d'énergie (GRDF, Enedis)
// ============================================

enum EnergyProviderType {
  GRDF
  ENEDIS
}

model EnergyProvider {
  id             String             @id @default(cuid())
  organizationId String
  provider       EnergyProviderType

  // OAuth tokens (stockés chiffrés)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  // Statut connexion
  isConnected Boolean   @default(false)
  lastSyncAt  DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("energy_providers")
}

// ============================================
// ENERGY REFERENCE PRICES
// ============================================

enum PriceType {
  PEG // Point d'Échange de Gaz - Prix spot du gaz naturel (€/MWh)
  TICGN // Taxe Intérieure Consommation Gaz Naturel (€/MWh)
  CEE // Certificats d'Économies d'Énergie (€/MWh cumac)
  TVD // Tarif de Distribution GRDF (€/MWh)
}

model EnergyPrice {
  id     String    @id @default(cuid())
  type   PriceType
  value  Float // Prix en €/MWh
  date   DateTime // Date d'application du prix
  source String? // Source de la donnée (EMMY, GRDF, manuel, etc.)
  notes  String? // Notes additionnelles

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, date])
  @@map("energy_prices")
}

// ============================================
// SUIVI DES TRAVAUX (Work Tracking)
// ============================================

enum WorkStatus {
  PLANIFIE // Travaux planifiés (devis accepté)
  EN_COURS // Travaux en cours d'exécution
  TERMINE // Travaux terminés sur site
  ATTENTE_ATTACHEMENT // Attachement reçu, en attente de levée
  ATTENTE_LEVEE // Réserves à lever
  CLOTURE // Travaux clôturés (comptés dans P3)
  ANNULE // Travaux annulés
}

enum AttachementType {
  PHOTO
  PDF
  DOCUMENT
  AUTRE
}

enum LeveeType {
  VISITE_ANNUELLE // Visite annuelle P2
  AUDIT_TECHNIQUE // Audit technique
  VISITE_DEDIEE // Visite dédiée pour levée
  AUTRE
}

// Ordre de Travail (Work Order) - Suivi de l'exécution des devis acceptés
model WorkOrder {
  id      String     @id @default(cuid())
  quoteId String     @unique
  status  WorkStatus @default(PLANIFIE)

  // Timeline
  planifiedDate  DateTime?
  startDate      DateTime?
  completionDate DateTime?
  closedAt       DateTime?
  closedBy       String?

  // Notes internes
  internalNotes String?

  // Annulation
  cancelledAt  DateTime?
  cancelReason String?

  // Relations
  quote        Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  attachements WorkAttachement[]
  reservations WorkReservation[]
  levees       WorkLevee[]
  events       WorkEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_orders")
}

// Pièces jointes prouvant l'exécution des travaux
model WorkAttachement {
  id          String          @id @default(cuid())
  workOrderId String
  type        AttachementType @default(PHOTO)
  fileName    String
  fileUrl     String
  fileSize    Int?
  description String?
  uploadedAt  DateTime        @default(now())
  uploadedBy  String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_attachements")
}

// Réserves détectées lors des inspections
model WorkReservation {
  id          String   @id @default(cuid())
  workOrderId String
  description String
  severity    String   @default("MINEURE") // MINEURE, MAJEURE, BLOQUANTE
  detectedAt  DateTime @default(now())
  detectedBy  String?

  // Levée de réserve
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_reservations")
}

// Levées de réserves (inspections post-travaux)
model WorkLevee {
  id          String    @id @default(cuid())
  workOrderId String
  type        LeveeType
  leveeDate   DateTime
  inspector   String?

  // Liens optionnels vers Meeting ou TechnicalAudit
  meetingId        String?
  technicalAuditId String?

  // Résultats
  allReservationsLifted Boolean @default(false)
  notes                 String?

  workOrder      WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  meeting        Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  technicalAudit TechnicalAudit? @relation(fields: [technicalAuditId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_levees")
}

// Journal d'audit pour traçabilité complète
model WorkEvent {
  id          String   @id @default(cuid())
  workOrderId String
  eventType   String // STATUS_CHANGE, ATTACHEMENT_ADDED, RESERVATION_ADDED, LEVEE_COMPLETED, CLOSED
  oldValue    String?
  newValue    String?
  performedBy String?
  performedAt DateTime @default(now())
  notes       String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_events")
}

// Cache jour-par-jour des DJU (degree-days) par station météo.
// Évite de re-fetch Open-Meteo à chaque interaction utilisateur :
// le cron quotidien remplit cette table, les API lisent depuis ici (~50 ms
// au lieu de 1-2 s par requête Open-Meteo).
// Mutualisée entre toutes les orgs : une seule entrée par (station, date).
model DailyDju {
  stationCode String
  date        DateTime @db.Date
  dju         Float // base 18°C (chauffage)
  updatedAt   DateTime @updatedAt

  @@id([stationCode, date])
  @@index([stationCode, date])
  @@map("daily_dju")
}

